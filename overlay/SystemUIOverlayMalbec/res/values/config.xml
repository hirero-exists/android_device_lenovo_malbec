<resources>
    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">false</bool>

    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
     vibrator is capable of subtle vibrations -->
    <bool name="config_vibrateOnIconAnimation">true</bool>

    <!-- Preferred refresh rate at keyguard, if supported by the display. Overrides
         keyguardMaxRefreshRate. -->
    <integer name="config_keyguardRefreshRate">120</integer>

    <!-- Preferred max refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">120</integer>


    <!-- Whether to play turbulence noise after clicking the play button -->
    <bool name="config_turbulenceNoise">false</bool>

    <string name="quick_settings_tiles_default" translatable="false">internet,bt,dnd,cast,flashlight,airplane,rotation,wallet,alarm,controls,screenrecord,battery,custom(com.lenovo.parts/.DesktopModeTile)</string>
    <string name="quick_settings_tiles_default_split" translatable="false">wifi,bt,cast,dnd,wallet,airplane,rotation,flashlight,battery,alarm,controls,screenrecord,custom(com.lenovo.parts/.DesktopModeTile)</string>
</resources>
