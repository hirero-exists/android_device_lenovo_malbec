package vendor.lenovo.hardware.pen;
@VintfStability
parcelable PenEvent {
  long generation;
  long sequence;
  long monotonicNanos;
  int kind;
  int usage;
  boolean pressed;
  boolean inRange;
  const int STATE_DISCONNECTED = 0;
  const int STATE_CONNECTED = 1;
  const int GESTURE = 2;
  const int RESET = 3;
  const int CORNER = 4;
  const int DIGITIZER_TAP = 5;
  const int PROXIMITY = 6;
}
