<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.preference.Preference
        android:key="pen_connection"
        android:title="@string/pen_connection_title"
        android:selectable="false" />
    <androidx.preference.Preference
        android:key="pen_transport"
        android:title="@string/pen_transport_title"
        android:selectable="false" />
    <androidx.preference.Preference
        android:key="pen_identity"
        android:title="@string/pen_identity_title"
        android:selectable="false" />
    <PreferenceCategory
        android:key="category_pen"
        android:title="@string/category_pen_title">
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pen_enabled"
            android:persistent="false"
            android:summary="@string/pen_enabled_summary"
            android:title="@string/pen_enabled_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="pen_enabled"
            android:key="pen_toolbar"
            android:persistent="false"
            android:summary="@string/pen_toolbar_summary"
            android:title="@string/pen_toolbar_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="pen_enabled"
            android:key="pen_gestures"
            android:persistent="false"
            android:summary="@string/pen_gestures_summary"
            android:title="@string/pen_gestures_title" />
        <androidx.preference.ListPreference
            android:defaultValue="6"
            android:dependency="pen_enabled"
            android:entries="@array/pen_action_entries"
            android:entryValues="@array/pen_action_values"
            android:key="pen_single_action"
            android:persistent="false"
            android:summary="%s"
            android:title="@string/pen_single_action_title" />
        <androidx.preference.ListPreference
            android:defaultValue="0"
            android:dependency="pen_enabled"
            android:entries="@array/pen_action_entries"
            android:entryValues="@array/pen_action_values"
            android:key="pen_double_action"
            android:persistent="false"
            android:summary="%s"
            android:title="@string/pen_double_action_title" />
        <androidx.preference.ListPreference
            android:defaultValue="0"
            android:dependency="pen_enabled"
            android:entries="@array/pen_action_entries"
            android:entryValues="@array/pen_action_values"
            android:key="pen_long_action"
            android:persistent="false"
            android:summary="%s"
            android:title="@string/pen_long_action_title" />
    </PreferenceCategory>
    <androidx.preference.ListPreference android:key="pen_corner_left" android:persistent="false"
        android:title="@string/pen_corner_left_title" android:entries="@array/pen_corner_entries"
        android:entryValues="@array/pen_corner_values" android:summary="%s" />
    <androidx.preference.ListPreference android:key="pen_corner_right" android:persistent="false"
        android:title="@string/pen_corner_right_title" android:entries="@array/pen_corner_entries"
        android:entryValues="@array/pen_corner_values" android:summary="%s" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_held_note" android:persistent="false"
        android:title="@string/pen_held_note_title" android:summary="@string/pen_held_note_summary" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_screen_off" android:persistent="false"
        android:title="@string/pen_screen_off_title" android:summary="@string/pen_held_note_summary" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_handwriting" android:persistent="false"
        android:title="@string/pen_handwriting_title" android:summary="@string/pen_handwriting_summary" />
    <androidx.preference.Preference android:key="pen_handwriting_settings"
        android:title="@string/pen_handwriting_settings_title" />
    <androidx.preference.MultiSelectListPreference android:key="pen_guard_apps" android:persistent="false"
        android:title="@string/pen_guard_apps_title" android:summary="@string/pen_guard_apps_summary" />
    <androidx.preference.Preference android:key="pen_palm" android:title="@string/pen_palm_title" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_refresh_cap" android:persistent="false"
        android:title="@string/pen_refresh_cap_title" android:summary="@string/pen_refresh_cap_summary" />
    <androidx.preference.ListPreference android:key="pen_remote" android:persistent="false"
        android:title="@string/pen_remote" android:entries="@array/pen_remote_entries"
        android:entryValues="@array/pen_remote_values" android:summary="@string/pen_remote_summary" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_hover" android:persistent="false"
        android:title="@string/pen_hover_title" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_sound" android:persistent="false"
        android:title="@string/pen_sound_title" />
    <androidx.preference.SwitchPreferenceCompat android:key="pen_lost_alert" android:persistent="false"
        android:title="@string/pen_lost_alert_title" />
    <androidx.preference.Preference android:key="pen_last_disconnected" android:selectable="false"
        android:title="@string/pen_last_disconnected_title" />
    <androidx.preference.EditTextPreference android:key="pen_name" android:persistent="false"
        android:title="@string/pen_name_title" />
    <androidx.preference.Preference
        android:key="pen_firmware"
        android:title="@string/pen_firmware_page_title" />
</PreferenceScreen>
