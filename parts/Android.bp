android_app {
    name: "LenovoParts",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    resource_dirs: ["app/res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSettingsTheme",
        "androidx.preference_preference",
    ],
    optimize: {
        enabled: true,
    },
}

cc_binary {
    name: "malbec_foliod",
    srcs: ["folio/malbec_foliod.cpp"],
    init_rc: ["init.malbec.rc"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    vendor: true,
}
