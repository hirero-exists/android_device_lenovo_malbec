aidl_interface {
    name: "vendor.lenovo.hardware.pen",
    owner: "lenovo",
    vendor_available: true,
    srcs: ["aidl/vendor/lenovo/hardware/pen/*.aidl"],
    local_include_dir: "aidl",
    stability: "vintf",
    frozen: true,
    versions_with_info: [{ version: "1", imports: [] }],
    backend: {
        cpp: { enabled: false },
        java: { platform_apis: true },
        ndk: { enabled: true },
    },
}

android_app {
    name: "LenovoParts",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    resource_dirs: ["app/res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSettingsTheme",
        "androidx.preference_preference",
        "vendor.lenovo.hardware.pen-V1-java",
    ],
    optimize: {
        enabled: true,
    },
}

prebuilt_etc {
    name: "privapp_permissions_com.lenovo.parts",
    src: "permissions/privapp-permissions-com.lenovo.parts.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default_permissions_com.lenovo.parts",
    src: "permissions/default-permissions-com.lenovo.parts.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

cc_binary {
    name: "malbec_partsd",
    srcs: [
        "backend/malbec_partsd.cpp",
        "backend/PenGuard.cpp",
        "backend/PenHal.cpp",
    ],
    init_rc: ["init.malbec.rc"],
    vintf_fragments: ["pen.xml"],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "vendor.lenovo.hardware.pen-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    vendor: true,
}
