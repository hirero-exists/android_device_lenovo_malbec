<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: The LineageOS Project
     SPDX-License-Identifier: Apache-2.0

     Framework compatibility matrix additions
     (DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE).

     Eight AIDL HALs on this device are Lenovo's own and appear in no AOSP
     matrix. They are declared optional: the vendor image provides them and
     they keep running, but nothing on the framework side is required to use
     them, so a build that ignores them still passes the VINTF check.

     Stock has ten. lenovo.hardware.ai and vendor.lenovo.hardware.factory are
     deliberately not shipped: the first is ZUI Gallery's super-resolution and
     face-restoration engine (which ran at nice -20 for zero clients), the
     second a retail-demo and country-code setter whose getFactoryTestPackageName
     points at an APK this build does not contain. Both were verified to have no
     caller anywhere in the image before removal. See the blob list.

     Versions and instances are taken verbatim from the vendor manifest
     fragments in /vendor/etc/vintf/manifest/ — those where no version is
     declared are AIDL version 1.
-->
<compatibility-matrix version="8.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.battery</name>
        <version>5</version>
        <interface>
            <name>IBattery</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.display</name>
        <interface>
            <name>IDisplay</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.hyperschedule</name>
        <version>2</version>
        <interface>
            <name>IHyperschedule</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.keyboard</name>
        <version>3</version>
        <interface>
            <name>IKeyboard</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.misc</name>
        <interface>
            <name>IMisc</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.performance</name>
        <interface>
            <name>IPerformance</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.touchscreen</name>
        <version>5</version>
        <interface>
            <name>ITouchscreen</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lenovo.hardware.usb</name>
        <version>2</version>
        <interface>
            <name>IUsb</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Third-party vendor HALs the stock image declares. These are not
         Lenovo's own, which is why the original pass over the vendor manifests
         missed them: it only looked at lenovo.* and vendor.lenovo.*.
         check_vintf then failed the build with

           The following instances are in the device manifest but not
           specified in framework compatibility matrix:
             vendor.dolby.dms.IDms/default (@1)
             vendor.dolby.dvs.IDvs/default (@1)
             vendor.microtrust.hardware.afw.IAFWDevice/default (@1)

         Declared optional for the same reason as the Lenovo ones: the vendor
         image provides them, nothing framework-side is required to use them.
         No <version> in the stock fragments means AIDL version 1.
         Taken verbatim from vendor/etc/vintf/manifest/{dms-service,
         dvs-aidl-service,manifest_afw}.xml. -->
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dms</name>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dvs</name>
        <interface>
            <name>IDvs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.microtrust.hardware.afw</name>
        <interface>
            <name>IAFWDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
