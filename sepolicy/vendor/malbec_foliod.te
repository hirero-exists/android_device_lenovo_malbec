type malbec_foliod, domain;
type malbec_foliod_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(malbec_foliod)

get_prop(malbec_foliod, malbec_folio_prop)

allow malbec_foliod self:capability2 syslog;
allow malbec_foliod kernel:system syslog_read;
allow malbec_foliod kmsg_device:chr_file { getattr open read };
allow malbec_foliod proc_lenovo_touchscreen:file { open write };
allow malbec_foliod uhid_device:chr_file { getattr ioctl open write };
