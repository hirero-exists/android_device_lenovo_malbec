+    @Test
+    @EnableFlags(Flags.FLAG_ENABLE_ADD_WINDOW_DECORATION_TO_ALL_TASKS)
+    fun relayout_invisibleTaskStillRequestedVisible_doesNotCreateResizeListener() {
+        val task = WindowDecorationTestHelper.createAppHeaderTask()
+        val decoration = setUpWindowDecoration(task)
+        task.isVisible = false
+        task.isVisibleRequested = true
+
+        decoration.relayout(task, true, Region())
+
+        assertFalse(decoration.isHandlingDragResize())
+    }
+
