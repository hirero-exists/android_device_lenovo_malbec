#

# CNE (connectivity engine -- kept; used for Wi-Fi data too)
persist.vendor.cne.feature=1

# Device
ro.product.marketname=Lenovo Idea Tab Pro 2
ro.product.mod_device=malbec_global

# HWUI
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.recorder-max-base-layer-fps=60
ro.media.xml_variant.profiles=_tuna_v0

# QTI
ro.vendor.qti.va_aosp.support=1

# WFD (wireless display)
persist.debug.wfd.enable=1
